-- تشغيل برمجة: FindScript
task.spawn(function()
	local script = setmetatable({Parent = ui_StartBtn_5, Name = "FindScript"}, {__index = ui_StartBtn_5})
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")
	
	local button = script.Parent
	local player = Players.LocalPlayer
	
	local BOAT_SPEED = 300
	local LIFT_HEIGHT = 12
	local CENTER_POSITION = Vector3.new(0, 20, 0) -- عدّل نقطة الوسط حسب خريطتك
	local CUSTOM_TWEEN_DURATION = 1.2
	
	-- حفظ الشكل والنص الأصلي للزر
	local originalColor = button.BackgroundColor3
	local originalText = button.Text
	local stopColor = Color3.fromRGB(200, 40, 40)
	
	local isRunning = false
	local moveConn = nil
	local tweenConn = nil
	
	local function setButtonStopMode(activeStop)
		if activeStop then
			button.BackgroundColor3 = stopColor
			button.Text = "Stop"
		else
			button.BackgroundColor3 = originalColor
			button.Text = originalText
		end
	end
	
	local function stopAllActivity(boatPrimary, rootPart, humanoid)
		if moveConn then
			moveConn:Disconnect()
			moveConn = nil
		end
		if tweenConn then
			tweenConn:Disconnect()
			tweenConn = nil
		end
	
		if boatPrimary and boatPrimary.Parent then
			boatPrimary.AssemblyLinearVelocity = Vector3.zero
			boatPrimary.AssemblyAngularVelocity = Vector3.zero
		end
	
		if rootPart and rootPart.Parent then
			rootPart.Anchored = false
			rootPart.AssemblyLinearVelocity = Vector3.zero
		end
	
		if humanoid and humanoid.Parent then
			humanoid.PlatformStand = false
		end
	
		isRunning = false
		setButtonStopMode(false)
	end
	
	local function customEaseOutCubic(t)
		return 1 - ((1 - t) ^ 3)
	end
	
	local function runCustomTweenToCenter(targetCenter, boatPrimary, rootPart, humanoid)
		if not rootPart or not humanoid then
			stopAllActivity(boatPrimary, rootPart, humanoid)
			return
		end
	
		local startPos = rootPart.Position
		local elapsed = 0
	
		rootPart.Anchored = true
	
		tweenConn = RunService.Heartbeat:Connect(function(dt)
			if not isRunning or not rootPart.Parent then
				stopAllActivity(boatPrimary, rootPart, humanoid)
				return
			end
	
			elapsed += dt
			local alpha = math.clamp(elapsed / CUSTOM_TWEEN_DURATION, 0, 1)
			local easedAlpha = customEaseOutCubic(alpha)
	
			local nextPos = startPos:Lerp(targetCenter, easedAlpha)
			rootPart.CFrame = CFrame.lookAt(nextPos, targetCenter)
	
			if alpha >= 1 then
				stopAllActivity(boatPrimary, rootPart, humanoid)
			end
		end)
	end
	
	local function setBoatNoclip(boatModel, enabled)
		local character = player.Character
		for _, part in ipairs(boatModel:GetDescendants()) do
			if part:IsA("BasePart") then
				local isPlayerPart = character and part:IsDescendantOf(character)
				if not isPlayerPart then
					part.CanCollide = not enabled
				end
			end
		end
	end
	
	local function findMirageObject()
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if string.find(string.lower(obj.Name), "mirage") then
				return obj
			end
		end
		return nil
	end
	
	local function getSeatedBoatAndSeat()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		if seat and (seat:IsA("Seat") or seat:IsA("VehicleSeat")) then
			local boat = seat:FindFirstAncestorOfClass("Model")
			return boat, seat, humanoid, character
		end
		return nil, nil, nil, nil
	end
	
	button.MouseButton1Click:Connect(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	
		-- إذا كان شغال مسبقاً، أوقف كل شيء وأرجع الزر لحالته الأصلية
		if isRunning then
			stopAllActivity(nil, rootPart, humanoid)
			return
		end
	
		local boat, seat
		boat, seat, humanoid, character = getSeatedBoatAndSeat()
		if not boat or not seat or not humanoid or not character then
			warn("اجلس على Seat أو VehicleSeat داخل القارب أولاً")
			return
		end
	
		rootPart = character:FindFirstChild("HumanoidRootPart")
		if not rootPart then return end
	
		local primary = boat.PrimaryPart or seat or boat:FindFirstChildWhichIsA("BasePart")
		if not primary then return end
	
		isRunning = true
		setButtonStopMode(true)
	
		for _, part in ipairs(boat:GetDescendants()) do
			if part:IsA("BasePart") and part ~= primary then
				local weld = part:FindFirstChild("BoatSingleWeld") or Instance.new("WeldConstraint")
				weld.Name = "BoatSingleWeld"
				weld.Part0 = primary
				weld.Part1 = part
				weld.Parent = part
				part.Anchored = false
			end
		end
		primary.Anchored = false
	
		primary.CFrame = primary.CFrame + Vector3.new(0, LIFT_HEIGHT, 0)
		setBoatNoclip(boat, true)
	
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				part.CanCollide = true
			end
		end
	
		moveConn = RunService.Heartbeat:Connect(function()
			if not isRunning then
				stopAllActivity(primary, rootPart, humanoid)
				return
			end
	
			if not boat.Parent or not primary.Parent then
				stopAllActivity(primary, rootPart, humanoid)
				return
			end
	
			if findMirageObject() then
				if moveConn then
					moveConn:Disconnect()
					moveConn = nil
				end
	
				primary.AssemblyLinearVelocity = Vector3.zero
				primary.AssemblyAngularVelocity = Vector3.zero
	
				humanoid.Sit = false
				local seatWeld = seat:FindFirstChild("SeatWeld") or rootPart:FindFirstChild("SeatWeld")
				if seatWeld then seatWeld:Destroy() end
	
				task.wait(0.05)
				if not isRunning then
					stopAllActivity(primary, rootPart, humanoid)
					return
				end
	
				rootPart.AssemblyLinearVelocity = Vector3.new(0, 55, 0) + (primary.CFrame.LookVector * 25)
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	
				task.wait(0.25)
				if not isRunning then
					stopAllActivity(primary, rootPart, humanoid)
					return
				end
	
				runCustomTweenToCenter(CENTER_POSITION, primary, rootPart, humanoid)
				return
			end
	
			local look = primary.CFrame.LookVector
			primary.AssemblyLinearVelocity = Vector3.new(look.X * BOAT_SPEED, 0, look.Z * BOAT_SPEED)
		end)
	end)
end)


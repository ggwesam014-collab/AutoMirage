-- تشغيل برمجة: FindScript
task.spawn(function()
	local script = setmetatable({Parent = ui_StartBtn_4, Name = "FindScript"}, {__index = ui_StartBtn_4})
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")
	
	local button = script.Parent
	local player = Players.LocalPlayer
	
	local BOAT_SPEED = 300
	local LIFT_HEIGHT = 25
	local MIN_SAFE_Y = 12 -- حد أمان أعلى من سطح البحر لمنع دمج الفاكهة
	local CENTER_POSITION = Vector3.new(0, 60, 0) -- عدّل نقطة الوسط حسب خريطتك
	local CUSTOM_TWEEN_DURATION = 1.2
	
	local originalColor = button.BackgroundColor3
	local originalText = button.Text
	local stopColor = Color3.fromRGB(200, 40, 40)
	
	local isRunning = false
	local moveConn = nil
	local tweenConn = nil
	local antiWaterConn = nil
	local disabledWaterParts = {}
	
	local function setButtonStopMode(activeStop)
		if activeStop then
			button.BackgroundColor3 = stopColor
			button.Text = "Stop"
		else
			button.BackgroundColor3 = originalColor
			button.Text = originalText
		end
	end
	
	-- حماية من دمج الموية لمستخدمي الفواكه (Terrain + Parts + ارتفاع البحر)
	local function setWaterProtection(enabled)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	
		if enabled then
			if humanoid then
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
			end
	
			for _, obj in ipairs(Workspace:GetDescendants()) do
				if obj:IsA("BasePart") then
					local n = string.lower(obj.Name)
					if string.find(n, "water") or string.find(n, "sea") or string.find(n, "ocean") or string.find(n, "damage") then
						if obj.CanTouch then
							obj.CanTouch = false
							table.insert(disabledWaterParts, obj)
						end
					end
				end
			end
	
			antiWaterConn = RunService.Heartbeat:Connect(function()
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local root = char and char:FindFirstChild("HumanoidRootPart")
	
				if hum then
					if hum:GetState() == Enum.HumanoidStateType.Swimming then
						hum:ChangeState(Enum.HumanoidStateType.Running)
					end
					hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
				end
	
				-- رفع اللاعب فوراً إذا اقترب من مستوى البحر أو نزل تحته
				if root and root.Position.Y < MIN_SAFE_Y then
					local rotOnly = root.CFrame - root.CFrame.Position
					root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
					root.CFrame = CFrame.new(root.Position.X, MIN_SAFE_Y + 4, root.Position.Z) * rotOnly
				end
			end)
		else
			if antiWaterConn then
				antiWaterConn:Disconnect()
				antiWaterConn = nil
			end
	
			if humanoid then
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
			end
	
			for _, part in ipairs(disabledWaterParts) do
				if part and part.Parent then
					part.CanTouch = true
				end
			end
			table.clear(disabledWaterParts)
		end
	end
	
	local function stopAllActivity(boatPrimary, rootPart, humanoid)
		if moveConn then
			moveConn:Disconnect()
			moveConn = nil
		end
		if tweenConn then
			tweenConn:Disconnect()
			tweenConn = nil
		end
	
		setWaterProtection(false)
	
		if boatPrimary and boatPrimary.Parent then
			boatPrimary.AssemblyLinearVelocity = Vector3.zero
			boatPrimary.AssemblyAngularVelocity = Vector3.zero
		end
	
		if rootPart and rootPart.Parent then
			rootPart.Anchored = false
			rootPart.AssemblyLinearVelocity = Vector3.zero
		end
	
		if humanoid and humanoid.Parent then
			humanoid.PlatformStand = false
		end
	
		isRunning = false
		setButtonStopMode(false)
	end
	
	local function customEaseOutCubic(t)
		return 1 - ((1 - t) ^ 3)
	end
	
	local function runCustomTweenToCenter(targetCenter, boatPrimary, rootPart, humanoid)
		if not rootPart or not humanoid then
			stopAllActivity(boatPrimary, rootPart, humanoid)
			return
		end
	
		local startPos = rootPart.Position
		local elapsed = 0
	
		rootPart.Anchored = true
	
		tweenConn = RunService.Heartbeat:Connect(function(dt)
			if not isRunning or not rootPart.Parent then
				stopAllActivity(boatPrimary, rootPart, humanoid)
				return
			end
	
			elapsed += dt
			local alpha = math.clamp(elapsed / CUSTOM_TWEEN_DURATION, 0, 1)
			local easedAlpha = customEaseOutCubic(alpha)
	
			local nextPos = startPos:Lerp(targetCenter, easedAlpha)
			rootPart.CFrame = CFrame.lookAt(nextPos, targetCenter)
	
			if alpha >= 1 then
				stopAllActivity(boatPrimary, rootPart, humanoid)
			end
		end)
	end
	
	local function setBoatNoclip(boatModel, enabled)
		local character = player.Character
		for _, part in ipairs(boatModel:GetDescendants()) do
			if part:IsA("BasePart") then
				local isPlayerPart = character and part:IsDescendantOf(character)
				if not isPlayerPart then
					part.CanCollide = not enabled
				end
			end
		end
	end
	
	local function findMirageObject()
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if string.find(string.lower(obj.Name), "mirage") then
				return obj
			end
		end
		return nil
	end
	
	local function getSeatedBoatAndSeat()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		if seat and (seat:IsA("Seat") or seat:IsA("VehicleSeat")) then
			local boat = seat:FindFirstAncestorOfClass("Model")
			return boat, seat, humanoid, character
		end
		return nil, nil, nil, nil
	end
	
	button.MouseButton1Click:Connect(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	
		if isRunning then
			stopAllActivity(nil, rootPart, humanoid)
			return
		end
	
		local boat, seat
		boat, seat, humanoid, character = getSeatedBoatAndSeat()
		if not boat or not seat or not humanoid or not character then
			warn("اجلس على المقعد داخل القارب أولاً")
			return
		end
	
		rootPart = character:FindFirstChild("HumanoidRootPart")
		if not rootPart then return end
	
		local primary = boat.PrimaryPart or seat
		if not boat.PrimaryPart then
			boat.PrimaryPart = primary
		end
	
		isRunning = true
		setButtonStopMode(true)
		setWaterProtection(true)
	
		-- تفعيل Noclip للقارب فقط مع بقاء تصادم اللاعب طبيعياً
		setBoatNoclip(boat, true)
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				part.CanCollide = true
			end
		end
	
		-- رفع القارب واللاعب مرة واحدة للأعلى
		local startPivot = boat:GetPivot()
		local liftedPivot = startPivot + Vector3.new(0, LIFT_HEIGHT, 0)
		local fixedY = math.max(liftedPivot.Position.Y, MIN_SAFE_Y + 8)
		boat:PivotTo(CFrame.new(liftedPivot.Position.X, fixedY, liftedPivot.Position.Z) * (liftedPivot - liftedPivot.Position))
	
		moveConn = RunService.Heartbeat:Connect(function(dt)
			if not isRunning then
				stopAllActivity(primary, rootPart, humanoid)
				return
			end
	
			if not boat.Parent or not primary.Parent or not rootPart.Parent or not humanoid.Parent then
				stopAllActivity(primary, rootPart, humanoid)
				return
			end
	
			-- إبقاء حالة الجلوس فعالة ما لم يظهر Mirage
			if not humanoid.Sit then
				humanoid.Sit = true
			end
	
			if findMirageObject() then
				if moveConn then
					moveConn:Disconnect()
					moveConn = nil
				end
	
				primary.AssemblyLinearVelocity = Vector3.zero
				primary.AssemblyAngularVelocity = Vector3.zero
	
				humanoid.Sit = false
				local seatWeld = seat:FindFirstChild("SeatWeld") or rootPart:FindFirstChild("SeatWeld")
				if seatWeld then seatWeld:Destroy() end
	
				task.wait(0.05)
				if not isRunning then
					stopAllActivity(primary, rootPart, humanoid)
					return
				end
	
				rootPart.AssemblyLinearVelocity = Vector3.new(0, 60, 0) + (primary.CFrame.LookVector * 25)
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	
				task.wait(0.25)
				if not isRunning then
					stopAllActivity(primary, rootPart, humanoid)
					return
				end
	
				runCustomTweenToCenter(CENTER_POSITION, primary, rootPart, humanoid)
				return
			end
	
			-- تحريك القارب واللاعب للأمام بسرعة 300 على ارتفاع ثابت بدون كسر الجلوس
			local currentPivot = boat:GetPivot()
			local look = currentPivot.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			if flatLook.Magnitude > 0.001 then
				flatLook = flatLook.Unit
			else
				flatLook = Vector3.new(0, 0, -1)
			end
	
			local nextPos = currentPivot.Position + (flatLook * BOAT_SPEED * dt)
			local rotMatrix = currentPivot - currentPivot.Position
			boat:PivotTo(CFrame.new(nextPos.X, fixedY, nextPos.Z) * rotMatrix)
	
			-- إذا انفصل اللاعب عن المقعد فجأة أثناء الحركة، نبقيه متزامناً مع القارب فوق سطح البحر
			if humanoid.SeatPart ~= seat and rootPart then
				local seatOffset = seat.CFrame:ToObjectSpace(rootPart.CFrame)
				rootPart.CFrame = seat.CFrame * seatOffset
			end
		end)
	end)
end)

